+    if offload_embeddings:
+        # Dense embedding tables stay in host RAM (lookups only); the rest moves to the GPU.
+        from cpu_embeddings import offload_embeddings as move_embeddings_to_host
+        from accelerate.hooks import remove_hook_from_module
+        move_embeddings_to_host(loaded, torch.device("cuda:0"))
+        remove_hook_from_module(loaded.language_model, recurse=True)
+        gc.collect()
+        loaded.to(device="cuda:0")
+        loaded.language_model.hf_device_map = {"": "cuda:0"}
+        gc.collect()
+        torch.cuda.empty_cache()
+        log.info("Dense embeddings kept on CPU (CLEF_OFFLOAD_EMBEDDINGS=1)")
