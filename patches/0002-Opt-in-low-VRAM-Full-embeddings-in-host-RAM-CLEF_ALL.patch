Subject: [PATCH 2/4] Opt-in low-VRAM Full: embeddings in host RAM
 (CLEF_ALLOW_LOW_VRAM_FULL, CLEF_OFFLOAD_EMBEDDINGS)

---
 Dockerfile.full-offload   |  7 +++++
 clef_service/app.py       | 17 ++++++++++-
 clef_service/hardware.py  |  3 +-
 runtime/cpu_embeddings.py | 60 +++++++++++++++++++++++++++++++++++++++
 4 files changed, 85 insertions(+), 2 deletions(-)
 create mode 100644 Dockerfile.full-offload
 create mode 100644 runtime/cpu_embeddings.py

diff --git a/Dockerfile.full-offload b/Dockerfile.full-offload
new file mode 100644
index 0000000..c551176
--- /dev/null
+++ b/Dockerfile.full-offload
@@ -0,0 +1,7 @@
+# Overlay on a locally built clef:local image: Full on <22 GiB GPUs by keeping the
+# dense embedding tables in host RAM (opt-in, see README section "Low-VRAM Full").
+ARG BASE=clef:local
+FROM ${BASE}
+COPY --chown=clef:clef clef_service/ /app/clef_service/
+COPY --chown=clef:clef runtime/ /app/runtime/
+ENV CLEF_ALLOW_LOW_VRAM_FULL=1 CLEF_OFFLOAD_EMBEDDINGS=1
