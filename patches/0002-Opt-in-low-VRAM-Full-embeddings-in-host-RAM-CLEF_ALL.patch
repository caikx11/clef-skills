diff --git a/runtime/cpu_embeddings.py b/runtime/cpu_embeddings.py
new file mode 100644
index 0000000..c0d243c
--- /dev/null
+++ b/runtime/cpu_embeddings.py
@@ -0,0 +1,60 @@
+"""Opt-in low-VRAM Full: keep the dense BF16 embedding tables in host RAM.
+
+The input embedding is only used as a row lookup, and Clef's decision head only
+looks up lexical rows of the output embedding, so neither table needs the GPU.
+The tables are stored as plain tensors (not Parameters), so they do not appear in
+``model.parameters()`` and the single-GPU parameter checks stay strict.
+"""
+import torch
+import torch.nn.functional as F
+
+
+class CpuEmbedding(torch.nn.Module):
+    def __init__(self, embedding):
+        super().__init__()
+        self.table = embedding.weight.data.detach().to("cpu").contiguous()
+        self.num_embeddings, self.embedding_dim = self.table.shape
+        self.padding_idx = embedding.padding_idx
+
+    @property
+    def weight(self):
+        return self.table
+
+    def forward(self, ids):
+        return F.embedding(ids.to("cpu"), self.table, self.padding_idx).to(ids.device, non_blocking=True)
+
+
+class CpuRows:
+    """Tensor-like view used by the head: ``rows[token_ids]`` returns CUDA rows."""
+    def __init__(self, table, device):
+        self.table, self.device = table, device
+        self.dtype, self.shape = table.dtype, table.shape
+
+    def is_floating_point(self):
+        return True
+
+    def __getitem__(self, ids):
+        return self.table[ids.to("cpu")].to(self.device)
+
+
+class CpuLMHead(torch.nn.Module):
+    def __init__(self, head, device):
+        super().__init__()
+        self.weight = CpuRows(head.weight.data.detach().to("cpu").contiguous(), device)
+        self.in_features, self.out_features = head.in_features, head.out_features
+
+    def forward(self, hidden):
+        raise RuntimeError("Clef never computes full-vocabulary logits; the output table is row-lookup only")
+
+
+def offload_embeddings(loaded, device):
+    """Replace both dense tables by host-side lookups. Call before moving to the GPU."""
+    backbone = loaded.language_model
+    tied = backbone.get_input_embeddings().weight.data_ptr() == backbone.get_output_embeddings().weight.data_ptr()
+    backbone.set_input_embeddings(CpuEmbedding(backbone.get_input_embeddings()))
+    if tied:
+        backbone.set_output_embeddings(CpuLMHead(backbone.get_output_embeddings(), device))
+        backbone.get_output_embeddings().weight.table = backbone.get_input_embeddings().table
+    else:
+        backbone.set_output_embeddings(CpuLMHead(backbone.get_output_embeddings(), device))
+    return loaded
